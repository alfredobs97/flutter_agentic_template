# =============================================================================
# INACTIVE BY DEFAULT — this file uses the `.yml.example` extension, which
# GitHub Actions does not recognise as a workflow file. Nothing in here runs
# until you:
#   1. Read it fully and adapt it to your project (signing, distribution
#      target, secrets).
#   2. Configure the secrets listed below in your repository/organization
#      settings.
#   3. Rename this file to `release.yml` (dropping `.example`) and commit it.
# This is a customizable STARTING POINT, not a working pipeline out of the
# box — in particular the artifact-upload step at the end only publishes a
# GitHub Actions workflow artifact until you pick and configure a real
# distribution target (see the commented Firebase App Distribution example).
#
# Tag convention
# ---------------
# Triggered by pushing a tag matching `v*` (e.g. `v1.2.0`). The release
# flavor (dev/prod) is NOT taken from the tag name — it is inferred from
# which long-lived branch the tagged commit is reachable from:
#   - reachable from `origin/main`  -> flavor = prod
#   - else reachable from `origin/dev` -> flavor = dev
#   - otherwise the job fails with a clear error. Only tag commits that are
#     on `main` or `dev` — tagging a feature branch is not supported.
#
# Required secrets (configure under Settings -> Secrets and variables ->
# Actions before renaming this file):
#   - ANDROID_KEYSTORE_BASE64    Base64-encoded release keystore (.jks/.p12).
#                                Optional: if absent, the build falls back to
#                                debug signing (see android/app/build.gradle.kts).
#   - ANDROID_KEYSTORE_PASSWORD  Password for the keystore file above.
#   - ANDROID_KEY_PASSWORD       Password for the individual signing key.
#   - ANDROID_KEY_ALIAS          Alias of the signing key inside the keystore.
#   - FIREBASE_APP_ID            (only if you uncomment the Firebase App
#                                Distribution block) Firebase app id to
#                                upload the APK to.
#   - FIREBASE_SERVICE_ACCOUNT   (only if you uncomment the Firebase App
#                                Distribution block) JSON credentials for a
#                                service account with distribution rights.
# =============================================================================

name: Release (EXAMPLE — rename to release.yml to activate)

on:
  push:
    tags:
      - "v*"

jobs:
  build-and-release:
    name: Build & release signed APK
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0 # full history needed to test branch reachability below

      - name: Infer flavor (prod=main, dev=dev) from the tagged commit
        id: flavor
        run: |
          git fetch origin main dev --quiet || true
          if git merge-base --is-ancestor "${{ github.sha }}" origin/main; then
            echo "flavor=prod" >> "$GITHUB_OUTPUT"
          elif git merge-base --is-ancestor "${{ github.sha }}" origin/dev; then
            echo "flavor=dev" >> "$GITHUB_OUTPUT"
          else
            echo "::error::Tag ${{ github.ref_name }} points at a commit that is not reachable from origin/main or origin/dev. Only tag commits on those branches." >&2
            exit 1
          fi

      - name: Derive version name from tag
        id: version
        run: echo "name=${GITHUB_REF_NAME#v}" >> "$GITHUB_OUTPUT"

      - name: Read pinned Flutter version from .fvmrc
        id: fvmrc
        run: echo "flutter-version=$(jq -r .flutter .fvmrc)" >> "$GITHUB_OUTPUT"

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      # Same reasoning as ci.yml: CI/CD pins the SDK directly via the action
      # (reading the version from .fvmrc), rather than going through fvm.
      - name: Set up Flutter ${{ steps.fvmrc.outputs.flutter-version }}
        uses: subosito/flutter-action@v2
        with:
          flutter-version: ${{ steps.fvmrc.outputs.flutter-version }}
          channel: stable

      - name: Install dependencies (pub workspace)
        run: flutter pub get

      # android/app/build.gradle.kts reads android/key.properties (gitignored
      # locally) for keyAlias/keyPassword/storeFile/storePassword, and falls
      # back to debug signing when that file is absent. Mirror that here: if
      # the keystore secret is configured, decode it and write
      # key.properties from the three companion secrets; otherwise skip and
      # let Gradle fall back to the debug key, same as a local build without
      # a keystore configured.
      - name: Restore Android signing keystore
        id: signing
        run: |
          if [ -n "${{ secrets.ANDROID_KEYSTORE_BASE64 }}" ]; then
            echo "${{ secrets.ANDROID_KEYSTORE_BASE64 }}" | base64 --decode > android/app/release.keystore.jks
            cat > android/key.properties <<EOF
          storePassword=${{ secrets.ANDROID_KEYSTORE_PASSWORD }}
          keyPassword=${{ secrets.ANDROID_KEY_PASSWORD }}
          keyAlias=${{ secrets.ANDROID_KEY_ALIAS }}
          storeFile=release.keystore.jks
          EOF
            echo "Restored release keystore from ANDROID_KEYSTORE_BASE64."
          else
            echo "No ANDROID_KEYSTORE_BASE64 secret configured — falling back to debug signing (see android/app/build.gradle.kts). Do not distribute this build to end users."
          fi

      - name: Build release APK (flavor=${{ steps.flavor.outputs.flavor }})
        run: |
          flutter build apk \
            --flavor ${{ steps.flavor.outputs.flavor }} \
            --dart-define=FLAVOR=${{ steps.flavor.outputs.flavor }} \
            --release \
            --build-name=${{ steps.version.outputs.name }} \
            --build-number=${{ github.run_number }}

      # Generic first stop: always upload the built APK as a workflow
      # artifact so it is retrievable from the Actions run regardless of
      # which distribution channel (if any) you wire up below.
      - name: Upload APK as workflow artifact
        uses: actions/upload-artifact@v4
        with:
          name: app-${{ steps.flavor.outputs.flavor }}-${{ steps.version.outputs.name }}
          path: build/app/outputs/flutter-apk/app-${{ steps.flavor.outputs.flavor }}-release.apk
          if-no-files-found: error

      # TODO: pick ONE (or more) real distribution target and fill it in.
      # This template has no backend/project bound to it, so no vendor
      # project/app id is hardcoded — uncomment and configure the block(s)
      # that match how you want to ship this build.

      # --- Option A: Firebase App Distribution ----------------------------
      # TODO: uncomment, then add FIREBASE_APP_ID and FIREBASE_SERVICE_ACCOUNT
      # as repository secrets before use.
      # - name: Upload to Firebase App Distribution
      #   uses: wzieba/Firebase-Distribution-Github-Action@v1
      #   with:
      #     appId: ${{ secrets.FIREBASE_APP_ID }}
      #     serviceCredentialsFileContent: ${{ secrets.FIREBASE_SERVICE_ACCOUNT }}
      #     groups: testers
      #     file: build/app/outputs/flutter-apk/app-${{ steps.flavor.outputs.flavor }}-release.apk

      # --- Option B: Google Play internal testing track -------------------
      # TODO: build an .aab instead of an .apk (`flutter build appbundle`)
      # and upload it with an action such as r0adkll/upload-google-play,
      # supplying your own Play service account JSON secret.

      # --- Option C: attach as a GitHub Release asset ----------------------
      # TODO: create a GitHub Release for this tag (e.g. via
      # `softprops/action-gh-release`) and attach the built APK as its
      # binary asset.
