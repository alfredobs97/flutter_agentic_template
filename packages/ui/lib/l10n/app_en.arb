{
  "@@locale": "en",
  "appTitle": "Flutter Agentic Template",
  "@appTitle": {
    "description": "The app's display name, used as the MaterialApp title and in the OS task switcher."
  },
  "homeScreenTitle": "Home",
  "@homeScreenTitle": {
    "description": "Title of the placeholder home screen shipped by the template."
  },
  "homeScreenPlaceholder": "Run the new-feature skill to replace this screen.",
  "@homeScreenPlaceholder": {
    "description": "Body copy on the placeholder home screen, pointing to the skill that scaffolds a real feature."
  },
  "genericErrorMessage": "Something went wrong. Please try again.",
  "@genericErrorMessage": {
    "description": "Fallback message shown when a DomainFailure has no more specific localized copy mapped to it."
  },
  "routeNotFoundTitle": "Page not found",
  "@routeNotFoundTitle": {
    "description": "Title shown by RouteErrorScreen when go_router fails to match a route."
  },
  "routeNotFoundMessage": "The page you're looking for doesn't exist.",
  "@routeNotFoundMessage": {
    "description": "Body copy shown by RouteErrorScreen when go_router fails to match a route."
  },
  "goHomeButtonLabel": "Go home",
  "@goHomeButtonLabel": {
    "description": "Button on RouteErrorScreen that navigates back to the home route."
  }
}
